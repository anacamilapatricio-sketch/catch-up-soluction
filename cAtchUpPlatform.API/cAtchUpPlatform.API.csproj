<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Version>0.0.1</Version>
    </PropertyGroup>

    <ItemGroup>
        <!-- AsP.nET cORE RELATED DEENDENCIES-->
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13"/>
        <PackageReference Include="Scalar.AspNetCore" Version="2.18.0"/>
        <!--Entity Framework Core related package-->
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentFiles; analyzers</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13"/>
        <!--MySQL Entity Framework Core related packages-->
        <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.9"/>
        <!--Namilng convention converdion related package-->
        <PackageReference Include="Humanizer" Version="3.0.10"/>
        
    </ItemGroup>

</Project>
